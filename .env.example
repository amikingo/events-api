# Copy to .env for local development. Never commit .env. Production values come from the orchestrator.
NODE_ENV=development
PORT=5010
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=events
POSTGRES_USER=events
POSTGRES_PASSWORD=change-me

POSTGRES_SSL=disable
POSTGRES_POOL_MAX=10

# Absolute folder for uploaded files (event covers). Unset: /assets/uploads (a mounted volume in production).
FILES_DIR=/Users/<you>/events-uploads

# Lifetime of this API's staff access tokens, in seconds.
APP_TOKEN_TTL_SECONDS=900

# auth-cheche base URL WITHOUT /v1 (the client adds /v1/... itself; startup refuses a trailing /v1).
# Production: https://auth.cheche.et/api
CENTRAL_AUTH_API=http://localhost:5003
# >= 32 chars. auth-cheche's shared secret (same name there), given to you by auth-cheche. One secret for
# two jobs, like bookings_api: verifies Central Auth (HS256) tokens AND signs this API's own staff tokens.
APP_AUTH_TOKEN=change-me-to-the-shared-central-auth-secret
# The Events product's service_id in auth-cheche. Sent on sign-in: accounts not registered for it are refused.
CENTRAL_AUTH_SERVICE_ID=00000000-0000-4000-8000-000000000000
CENTRAL_AUTH_TIMEOUT_MS=10000

# AUTH_REFRESH_COOKIE_SECURE defaults to true in production
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# auth-cheche refresh tokens live 7 days
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_REFRESH_TRUSTED_ORIGINS=http://localhost:3000
# Optional. Set only when the API is served behind a proxy path prefix, e.g. /api.
# Form: /segment[/segment], no trailing slash. Put in front of every auth cookie path.
# AUTH_REFRESH_COOKIE_PATH_PREFIX=/api

# Optional, default 21600 (6 hours). How long staff refresh may skip Central Auth after Central last
# confirmed the person (assignments are still re-checked every time). 0 = ask Central on every refresh.
# AUTH_CENTRAL_SESSION_TTL_SECONDS=21600
