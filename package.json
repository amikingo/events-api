{
  "name": "events-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --import ./tests/setup-env.ts --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run openapi:check",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts up",
    "db:migrate:undo": "tsx --env-file-if-exists=.env src/scripts/migrate.ts down",
    "db:migrate:status": "tsx --env-file-if-exists=.env src/scripts/migrate.ts status",
    "db:migration:create": "tsx src/scripts/migrate.ts create",
    "openapi": "tsx src/scripts/generate-openapi.ts",
    "openapi:check": "tsx src/scripts/generate-openapi.ts --check",
    "bootstrap:super-admin": "tsx --env-file-if-exists=.env src/scripts/bootstrap-super-admin.ts",
    "provision:organizer": "tsx --env-file-if-exists=.env src/scripts/provision-organizer.ts",
    "assign:staff": "tsx --env-file-if-exists=.env src/scripts/assign-staff.ts",
    "dev:staff-token": "tsx --env-file-if-exists=.env src/scripts/dev-staff-token.ts"
  }
}
